<%- include('../cabecalho')%>
    <div>
        <tr><a href="../paleontologo"> ← Voltar </a></tr>
        <h3>Atualizar Paleontólogo</h3>

        <form method="post">
            <tr>
                <p>ID</p>
                <input type="text" name="id" value="<%=paleontologos.id%>">
                <br><br>
                <p>Nome</p>
                <input type="text" name="nome" value="<%=paleontologos.nome%>">
                <p>Nascimento</p>
                <input type="text" name="periodo" value="<%=paleontologos.nascimento%>">
                <p>Descoberta</p>
                <input type="text" name="descoberta" value="<%=paleontologos.descoberta%>">
            </tr>

            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>

    </body>

    </html>